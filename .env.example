# Copy this file to .env and fill in real values. Never commit .env itself.

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Demo user (stand-in for a real users table / IdP) ---
DEMO_USERNAME=demo
# bcrypt hash of "changeme123" — generate your own with:
# python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('yourpassword'))"
DEMO_PASSWORD_HASH=$$2b$$12$$lpBzJMqngW5dZJI1SN6RIOIJ5iOPTRptOCNDSa8HUdXZbMDrtmo76
DEMO_ROLE=admin

# --- Database (matches docker-compose service names) ---
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/aiqa

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=300
RATE_LIMIT_PER_MINUTE=60

# --- LLM (Google Gemini) ---
# Free API key, no card required: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=3
